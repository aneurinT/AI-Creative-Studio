# ========================
# AI Creative Studio - 环境变量配置
# 复制此文件为 .env 并填入您的 API Key
# ========================

# 通义万相（阿里云百炼平台）- 图片和视频生成
# 获取地址：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# 智谱AI - LLM 对话 + CogView 图片 + CogVideoX 视频
# 获取地址：https://www.bigmodel.cn/usercenter/apikeys
ZHIPU_API_KEY=your_zhipu_api_key_here

# 火山方舟 - 图片生成（Seedream）和视频生成（Seedance）
# 获取地址：https://console.volcengine.com/ark/region:ark+cn-beijing/apiKey
VOLCENGINE_API_KEY=your_volcengine_api_key_here
VOLCENGINE_MODEL_ID=doubao-seedream-4-0-250828

# Seedance 2.0 视频生成（火山引擎 ARK）
# 使用与 VOLCENGINE_API_KEY 相同的 Key 或单独的 Key
SEEDANCE_API_KEY=your_seedance_api_key_here

# Agnes Video V2.0（国外视频生成服务，国内可能需要代理）
# 获取地址：https://www.runninghub.ai/
# 注意：国内网络可能无法直连
AGNES_VIDEO_API_KEY=your_agnes_api_key_here

# DeepSeek API（AI助手对话模型）
# 获取地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# LTX-Video 本地推理服务（可选，需要 GPU + Python 环境）
# 部署方式见 ltx-video-server/README.md
LTX_SERVER_URL=http://localhost:8000

# ========================
# 自媒体平台集成（可选）
# 抖音/快手/小红书 OAuth 2.0 授权
# ========================
# 抖音开放平台 - https://open.douyin.com/
DOUYIN_CLIENT_KEY=your_douyin_client_key
DOUYIN_CLIENT_SECRET=your_douyin_client_secret

# 快手开放平台 - https://open.kuaishou.com/
KUAISHOU_CLIENT_KEY=your_kuaishou_client_key
KUAISHOU_CLIENT_SECRET=your_kuaishou_client_secret

# 小红书开放平台 - https://open.xiaohongshu.com/
XIAOHONGSHU_CLIENT_KEY=your_xiaohongshu_client_key
XIAOHONGSHU_CLIENT_SECRET=your_xiaohongshu_client_secret

# ========================
# 办公工具集成（可选）
# 钉钉/飞书/企业微信 Webhook 机器人
# ========================
# 钉钉机器人 Webhook Token
DINGTALK_WEBHOOK_TOKEN=your_dingtalk_webhook_token

# 飞书机器人 Webhook Token
FEISHU_WEBHOOK_TOKEN=your_feishu_webhook_token

# 企业微信机器人 Webhook Key
WECOM_WEBHOOK_TOKEN=your_wecom_webhook_key

# JWT 密钥（用户认证，生产环境请修改为随机字符串）
JWT_SECRET=change-me-to-a-random-string
