# Express 后端 Dockerfile
FROM node:22-alpine

WORKDIR /app

# 安装 ffmpeg（视频拼接需要）
RUN apk add --no-cache ffmpeg

# 复制 package 文件
COPY package.json package-lock.json* ./

# 安装依赖（优先用 package-lock.json，没有则生成）
RUN if [ -f package-lock.json ]; then npm ci --omit=dev; else npm install --omit=dev; fi

# 复制源码
COPY api/ ./api/
COPY .env ./

# 创建数据目录
RUN mkdir -p api/data api/public/images api/public/uploads api/public/videos api/data/temp_videos

EXPOSE 3001

CMD ["node", "--import", "tsx/esm", "api/server.ts"]
